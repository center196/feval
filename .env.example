# Copy this file to .env when local credentials or reporting options are needed.
# Never commit .env.

# Required for Hub uploads or access to private repositories.
HF_TOKEN=

# Optional: read the Hugging Face token from a protected local file.
# HF_TOKEN_PATH=/secure/local/path/hf-token

# Optional runtime controls.
# vLLM startup defaults are applied automatically; no exports are required.
# Uncomment only to explicitly override these defaults.
# VLLM_WORKER_MULTIPROC_METHOD=spawn
# VLLM_USE_FLASHINFER_SAMPLER=0
# FEVAL_VLLM_LORA_WARMUP=0
# FEVAL_VLLM_SHUTDOWN_TIMEOUT_SECONDS=10

# Optional public validator reporting. Set FEVAL_REPORT_WANDB=0 to disable it.
# Public validator results use this fixed destination.
FEVAL_REPORT_WANDB=1
WANDB_PROJECT=feval-valid
WANDB_ENTITY=feval196-feval
# WANDB_API_KEY=
