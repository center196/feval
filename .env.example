# Copy to .env on miner hosts that need to upload to Hugging Face.
# Validators do not need a token for public model and rollout repositories.

# Required for miners publishing models/rollouts to private repos, or when Hub
# write access is not already available through the standard Hugging Face cache.
HF_TOKEN=

# Optional: store the token in a separate local file instead of directly here.
# HF_TOKEN_PATH=/secure/local/path/hf-token

# Feval pins BF16, eager execution, and the GDN-compatible vLLM settings in code
# because these settings affect consensus. EngineCore child processes are
# cleaned up within a bounded shutdown period.
# Set to 0 only if you want to measure cold first-batch latency directly.
# FEVAL_VLLM_LORA_WARMUP=0
# Maximum graceful cleanup wait before Feval terminates stuck vLLM children.
# FEVAL_VLLM_SHUTDOWN_TIMEOUT_SECONDS=10

# Optional public summary mirror. Validators try this by default, but missing
# credentials/package/network never affect audits or weights. Set to 0 to opt out.
FEVAL_REPORT_WANDB=1
WANDB_PROJECT=feval-subnet-47
# WANDB_ENTITY=
# WANDB_API_KEY=
